{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "nextjs", "jsx-a11y", "vitest"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    // 既存テストを壊さないため。型付きモックは段階的に揃える
    "vitest/require-mock-type-parameters": "off"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    ".next/**",
    "out/**",
    "build/**",
    "coverage/**",
    "playwright-report/**",
    "storybook-static/**",
    "next-env.d.ts"
  ],
  "settings": {
    "react": {
      "version": "19.2.8"
    },
    "next": {
      "rootDir": "."
    }
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.stories.tsx"],
      "env": {
        "vitest": true
      }
    }
  ]
}
